# Copie este arquivo para .env.local (no seu computador) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
# NUNCA envie o .env.local para o GitHub (o .gitignore já impede).

# --- Supabase (obrigatórias) -------------------------------------------------
# Supabase → Project Settings → API (ou "Data API").
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública "anon" (pode ir para o navegador; a segurança vem das regras do banco).
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
# Chave "service_role": SECRETA, só o servidor usa. Nunca coloque em código.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role

# --- Cofre das senhas das ferramentas (obrigatória) ---------------------------
# 32 bytes em base64. Gere com: openssl rand -base64 32
# Guarde uma cópia em lugar seguro: sem ela, as senhas já salvas não abrem mais.
TOOLS_ENC_KEY=gere-com-openssl-rand-base64-32

# --- Endereço e nome do sistema (opcionais) -----------------------------------
# Endereço público do sistema, usado nos links dos e-mails e do WhatsApp.
# Na Vercel, se ficar vazio, o sistema usa sozinho o domínio de produção do projeto.
NEXT_PUBLIC_APP_URL=https://seu-dominio.com.br
# Alternativa antiga ao NEXT_PUBLIC_APP_URL (só use se não preencher a de cima).
APP_URL=
# Nome que aparece nas telas, nos e-mails e no app de 2FA. Padrão: "Vórtex Flow".
NEXT_PUBLIC_APP_NAME=Vórtex Flow

# --- E-mail (opcional, via Resend) ---------------------------------------------
# Sem ela o sistema funciona, mas não manda e-mail (convite, código de senha, tarefa nova).
RESEND_API_KEY=
# Remetente dos e-mails. Precisa ser de um domínio verificado no Resend.
EMAIL_FROM=Sua Empresa <nao-responda@seu-dominio.com.br>

# --- Aviso no WhatsApp quando uma tarefa é atribuída (opcional) ------------------
# Segredo que o banco usa para chamar o sistema. Gere com: openssl rand -hex 32
# O MESMO valor vai no Vault do Supabase com o nome webhook_dispatch_secret (INSTALACAO.md).
WEBHOOK_DISPATCH_SECRET=

# --- Preenchidas pela Vercel sozinha (não cadastre) ------------------------------
# VERCEL_PROJECT_PRODUCTION_URL e VERCEL_URL: usadas só se NEXT_PUBLIC_APP_URL estiver vazia.
